#!name = 番茄小说 · 救援分流 11
#!desc = 登录/授权/图片/听书/短剧 等「功能域名」强制直连，用来压住别的规则里对字节系的整域 REJECT
#!author = Xhy333
#!update = 2026-10-28
#
# 用法（关键）：QX → 配置 → 引用 → 把这个资源【拖到最上面】，排在其他过滤器之前。
# QX 的过滤器是「先命中先生效」，直连规则必须在 REJECT 之前，否则压不住。
#
# 你原来的 Fqxsfl.list 只救了 amemv.com / toutiaocloud.com（直播间与头像），
# 但登录还依赖 snssdk / bytedance / zijieapi —— 这些在你旧 Fqxs.list 里是整域 REJECT，
# 所以登录、书城、短剧会一起挂。这个文件把该放行的都放行。
#
# 若还要在 Surge / Loon 用：host-suffix → DOMAIN-SUFFIX，host → DOMAIN，direct → DIRECT。

# ---------- 账号 / 登录 / 抖音授权 ----------
# 账号、登录、抖音授权（i.snssdk.com 等）
host-suffix, snssdk.com, direct
# 字节账号体系
host-suffix, bytedance.com, direct
# 头条账号打通
host-suffix, toutiao.com, direct
# 安全校验（登录必过）
host, security.snssdk.com, direct
# 单点登录
host, sso.bytedance.com, direct

# ---------- 抖音 / 直播间 ----------
# 直播间（原 Fqxsfl.list）
host-suffix, amemv.com, direct
# 头像（原 Fqxsfl.list）
host-suffix, toutiaocloud.com, direct
# 抖音授权回调
host-suffix, douyin.com, direct

# ---------- 书城 / 界面资源 / 图片 ----------
# Lynx 界面资源（书城白屏就是它）
host-suffix, bytegecko.com, direct
# 接口 / 评论
host-suffix, zijieapi.com, direct
# 封面图
host-suffix, fqnovelpic.com, direct
# 静态资源
host-suffix, fqnovelstatic.com, direct
# 图片 CDN
host-suffix, byteimg.com, direct
# 图片 CDN 备用
host-suffix, snssdkpic.com, direct

# ---------- 听书 / 短剧 音视频 ----------
# 听书音频、短剧视频（拦了直接没声/黑屏）
host-suffix, fqnovelvod.com, direct
# 音视频 CDN
host-suffix, fqnovelcdn.com, direct

# ---------- 抖音商城 ----------
# 京东（商城跳转）
host-suffix, jd.com, direct
# 抖音商城后端
host-suffix, jinritemai.com, direct
# 抖音电商
host-suffix, douyinec.com, direct
